{
  "uid": "component-remote-wakeup-api",
  "title": "Component - Remote Wakeup API",
  "tags": ["component", "remote-wakeup", "poc"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "links": [
    {"title": "Up to Feature", "type": "link", "url": "/d/feature-remote-wakeup", "icon": "external link"},
    {"title": "Up to Fleet", "type": "link", "url": "/d/fleet", "icon": "external link"}
  ],
  "panels": [
    {
      "type": "timeseries", "id": 1, "title": "Wakeup Requests (rate/min)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (wakeup_status) (rate(remote_wakeup_requests_total[1m])) * 60", "legendFormat": "{{wakeup_status}}"}]
    },
    {
      "type": "timeseries", "id": 2, "title": "Wakeup Duration (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(remote_wakeup_duration_ms_milliseconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(remote_wakeup_duration_ms_milliseconds_bucket[5m])))", "legendFormat": "p50"}
      ]
    },
    {
      "type": "logs", "id": 3, "title": "Logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service_name=\"remote-wakeup-api\"}"}],
      "options": {"showTime": true, "wrapLogMessage": true}
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
