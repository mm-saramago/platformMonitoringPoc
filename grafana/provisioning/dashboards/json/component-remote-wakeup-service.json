{
  "uid": "component-remote-wakeup-service",
  "title": "Component - Remote Wakeup Service",
  "tags": [
    "component",
    "remote-wakeup",
    "poc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Up to Feature",
      "type": "link",
      "url": "/d/feature-remote-wakeup",
      "icon": "external link"
    },
    {
      "title": "Up to Fleet",
      "type": "link",
      "url": "/d/fleet",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Message Sync Rate (/min) [counter]",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (wakeup_status) (rate(vehicle_message_sync_count_total{service_name=\"remote-wakeup-service\"}[1m])) * 60",
          "legendFormat": "{{wakeup_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Message Backlog by Train [gauge]",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vehicle_message_backlog{service_name=\"remote-wakeup-service\"}",
          "legendFormat": "{{vehicle_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Heartbeat Lag (s) [gauge]",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vehicle_heartbeat_lag_seconds{service_name=\"remote-wakeup-service\"}",
          "legendFormat": "{{vehicle_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "gauge",
      "id": 4,
      "title": "Connectivity State [gauge]",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "vehicle_connectivity_state_ratio{service_name=\"remote-wakeup-service\"}",
          "legendFormat": "{{vehicle_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "type": "gauge",
      "id": 5,
