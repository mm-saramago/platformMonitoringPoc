{
  "uid": "ct-crosscutting-service",
  "title": "Component Type - Crosscutting Service",
  "tags": [
    "component-type",
    "poc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "fleet",
        "type": "query",
        "label": "Fleet",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(component_health_ratio, fleet_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "environment",
        "type": "query",
        "label": "Environment",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(component_health_ratio, deployment_environment)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\", deployment_environment=~\"$environment\", component_type=\"crosscutting-service\"}, service_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "component",
        "type": "query",
        "label": "Component",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\", deployment_environment=~\"$environment\", service_name=~\"$service\", component_type=\"crosscutting-service\"}, component_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/fleet",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "$service",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "repeat": "service"
    },
    {
      "type": "stat",
      "title": "Health",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "component_health_ratio{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.49,
                "result": {
                  "text": "UNHEALTHY",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 0.99,
                "result": {
                  "text": "DEGRADED",
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1,
                "result": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Gateway Conn",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 3,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway_connections_active{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "textMode": "auto"
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "messaging_queue_depth{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"}",
          "legendFormat": "{{messaging_destination_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Pub vs Consume /min",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 11,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name) (rate(messaging_publish_messages_total{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"}[1m])) * 60",
          "legendFormat": "pub {{messaging_destination_name}}"
        },
        {
          "refId": "B",
          "expr": "sum by (messaging_destination_name) (rate(messaging_process_messages_total{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"}[1m])) * 60",
          "legendFormat": "cons {{messaging_destination_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {}
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Routing Duration",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 17,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_routing_duration_seconds_bucket{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 6
    },
    {
      "type": "gauge",
      "title": "CPU%",
      "gridPos": {
        "h": 5,
        "w": 2,
        "x": 22,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage_ratio{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", deployment_environment=~\"$environment\"} * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 7
    },
    {
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\", deployment_environment=~\"$environment\"} | component_name=~\"$component\" | fleet_name=~\"$fleet\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true
      },
      "fieldConfig": {
        "defaults": {}
      },
      "id": 100
    }
  ]
}
