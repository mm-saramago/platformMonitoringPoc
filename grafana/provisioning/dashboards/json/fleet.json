    {
      "type": "stat",
      "id": 1,
      "title": "Remote Wakeup (Feature)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((clamp_max(count(count_over_time(business_transaction_count_total{service_name=\"remote-wakeup-api\"}[2m])), 1)) or on() vector(0)) + ((clamp_max(count(count_over_time(vehicle_message_sync_count_total{service_name=\"remote-wakeup-service\"}[2m])), 1)) or on() vector(0))) == bool 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DEGRADED",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Drill down to Feature",
              "url": "/d/feature-remote-wakeup",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
