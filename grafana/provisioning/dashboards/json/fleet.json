{
  "uid": "fleet",
  "title": "Fleet",
  "tags": [
    "fleet",
    "poc"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Features",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Remote Wakeup (Feature)",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((min(service_dependency_up_ratio{service_name=\"remote-wakeup-api\"}) or on() vector(0)) + (avg(vehicle_connectivity_state_ratio{service_name=\"remote-wakeup-service\"}) or on() vector(0))) / 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.49,
                "result": {
                  "text": "UNHEALTHY",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 0.99,
                "result": {
                  "text": "DEGRADED",
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1,
                "result": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Drill down",
              "url": "/d/feature-remote-wakeup",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "id": 200,
      "title": "Crosscutting",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Crosscutting Component Infrastructure",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((avg(watchdog_check_health_ratio{service_name=\"k8s-node\"}) or on() vector(0)) + (min(service_dependency_up_ratio{service_name=\"t2g-gateway\"}) or on() vector(0)) + (((max(messaging_queue_depth{service_name=\"rabbitmq\"}) < bool 2000) + (max(messaging_queue_depth{service_name=\"rabbitmq\"}) < bool 500)) / 2 or on() vector(1)) + (((max(messaging_queue_depth{service_name=\"mqtt-broker\"}) < bool 2000) + (max(messaging_queue_depth{service_name=\"mqtt-broker\"}) < bool 500)) / 2 or on() vector(1)) + (avg(watchdog_check_health_ratio{service_name=\"vpn-terminator-ground\"}) or on() vector(0)) + (avg(watchdog_check_health_ratio{service_name=\"vpn-monitor\"}) or on() vector(0))) / 6"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0.49,
                "result": {
                  "text": "UNHEALTHY",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0.5,
                "to": 0.99,
                "result": {
                  "text": "DEGRADED",
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1,
                "result": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Drill down",
              "url": "/d/crosscutting-infra",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}