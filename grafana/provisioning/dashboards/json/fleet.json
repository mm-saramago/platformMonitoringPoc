              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "Drill down",
              "url": "/d/crosscutting-infra?var-fleet=$fleet&var-cc_group=$cc_group",
              "targetBlank": false
