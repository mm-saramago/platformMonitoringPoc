{
  "uid": "infra-t2g-gateway",
  "title": "Infra - T2G Gateway",
  "tags": ["infra", "t2g", "poc"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "links": [
    {"title": "Up to Crosscutting Infra", "type": "link", "url": "/d/crosscutting-infra", "icon": "external link"},
    {"title": "Up to Fleet", "type": "link", "url": "/d/fleet", "icon": "external link"}
  ],
  "panels": [
    {
      "type": "timeseries", "id": 1, "title": "Messages Routed (rate/min) by status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (route_status) (rate(t2g_gateway_messages_total[1m])) * 60", "legendFormat": "{{route_status}}"}]
    },
    {
      "type": "timeseries", "id": 2, "title": "Active Train Connections",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "t2g_gateway_active_train_connections_ratio", "legendFormat": "active"}]
    },
    {
      "type": "timeseries", "id": 3, "title": "Route Duration (p50/p95)",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(t2g_gateway_route_duration_ms_milliseconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(t2g_gateway_route_duration_ms_milliseconds_bucket[5m])))", "legendFormat": "p50"}
      ]
    },
    {
      "type": "logs", "id": 4, "title": "Logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service_name=\"t2g-gateway\"}"}],
      "options": {"showTime": true, "wrapLogMessage": true}
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
