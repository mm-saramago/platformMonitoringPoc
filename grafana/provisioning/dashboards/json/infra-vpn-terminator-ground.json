{
  "uid": "infra-vpn-terminator-ground",
  "title": "Infra - VPN Terminator (Ground)",
  "tags": ["infra", "vpn", "poc"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "links": [
    {"title": "Up to Crosscutting Infra", "type": "link", "url": "/d/crosscutting-infra", "icon": "external link"},
    {"title": "Up to Fleet", "type": "link", "url": "/d/fleet", "icon": "external link"}
  ],
  "panels": [
    {
      "type": "timeseries", "id": 1, "title": "Active Tunnels",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "vpn_terminator_active_tunnels_ratio", "legendFormat": "tunnels"}]
    },
    {
      "type": "timeseries", "id": 2, "title": "Throughput (Mbps)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "vpn_terminator_throughput_mbps_Mbit_per_second", "legendFormat": "mbps"}]
    },
    {
      "type": "timeseries", "id": 3, "title": "Handshakes (rate/min) by status",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (handshake_status) (rate(vpn_terminator_handshakes_total[1m])) * 60", "legendFormat": "{{handshake_status}}"}]
    },
    {
      "type": "logs", "id": 4, "title": "Logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"refId": "A", "expr": "{service_name=\"vpn-terminator-ground\"}"}],
      "options": {"showTime": true, "wrapLogMessage": true}
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []}
}
