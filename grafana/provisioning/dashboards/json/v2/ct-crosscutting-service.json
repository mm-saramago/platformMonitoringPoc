{
  "uid": "v2-ct-crosscutting-service",
  "title": "Component Type - Crosscutting Service (v2)",
  "tags": ["component-type", "v2"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "fleet",
        "type": "query",
        "label": "Fleet",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio, fleet_name)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "hide": 0, "includeAll": true, "multi": true, "allValue": ".*"
      },
      {
        "name": "functionality_feature",
        "type": "query",
        "label": "Functionality Feature",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\"}, feature_type)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "hide": 0, "includeAll": true, "multi": true, "allValue": ".*"
      },
      {
        "name": "component",
        "type": "query",
        "label": "Component",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\", component_type=\"crosscutting-service\"}, component_name)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "hide": 0, "includeAll": true, "multi": true, "allValue": ".*"
      },
      {
        "name": "service",
        "type": "query",
        "label": "Sub-component (service)",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\", component_name=~\"$component\", component_type=\"crosscutting-service\"}, service_name)", "refId": "StandardVariableQuery" },
        "refresh": 2, "sort": 1, "hide": 0, "includeAll": true, "multi": true, "allValue": ".*"
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [
    { "title": "\u2b06 Fleet", "type": "link", "url": "/d/v2-fleet?var-fleet=$fleet", "icon": "external link" },
    { "title": "\u2b06 Feature", "type": "link", "url": "/d/v2-feature?var-fleet=$fleet&var-functionality_feature=$functionality_feature", "icon": "external link" }
  ],
  "panels": [
    {
      "type": "row", "id": 1, "title": "$service",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false, "repeat": "service"
    },
    {
      "type": "stat", "title": "Health", "id": 2,
      "gridPos": { "h": 5, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "component_health_ratio{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "range", "options": { "from": 0, "to": 0.49, "result": { "text": "UNHEALTHY", "color": "red", "index": 0 } } },
        { "type": "range", "options": { "from": 0.5, "to": 0.99, "result": { "text": "DEGRADED", "color": "orange", "index": 1 } } },
        { "type": "range", "options": { "from": 1, "to": 1, "result": { "text": "HEALTHY", "color": "green", "index": 2 } } }
      ], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Dep Up", "id": 3,
      "gridPos": { "h": 5, "w": 3, "x": 3, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "service_dependency_up_ratio{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "range", "options": { "from": 0, "to": 0.49, "result": { "text": "UNHEALTHY", "color": "red", "index": 0 } } },
        { "type": "range", "options": { "from": 0.5, "to": 0.99, "result": { "text": "DEGRADED", "color": "orange", "index": 1 } } },
        { "type": "range", "options": { "from": 1, "to": 1, "result": { "text": "HEALTHY", "color": "green", "index": 2 } } }
      ], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "green", "value": 1 }] }, "color": { "mode": "thresholds" } } },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Queue Depth", "id": 4,
      "gridPos": { "h": 5, "w": 3, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "messaging_queue_depth{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}" }],
      "fieldConfig": { "defaults": {} },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" }
    },
    {
      "type": "timeseries", "title": "Message Throughput", "id": 5,
      "gridPos": { "h": 5, "w": 7, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(messaging_messages_delivered_total{service_name=~\"$service\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}[5m])", "legendFormat": "delivered/s" },
        { "refId": "B", "expr": "rate(messaging_messages_published_total{service_name=~\"$service\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}[5m])", "legendFormat": "published/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "gauge", "title": "CPU%", "id": 6,
      "gridPos": { "h": 5, "w": 3, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "process_cpu_usage_ratio{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"} * 100" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "gauge", "title": "Mem", "id": 7,
      "gridPos": { "h": 5, "w": 3, "x": 19, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "process_memory_usage_bytes{service_name=~\"$service\", component_name=~\"$component\", fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "max": 536870912, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 268435456 }, { "color": "red", "value": 429496729 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "logs", "title": "Logs", "id": 100,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=~\"$service\"} | component_name=~\"$component\" | fleet_name=~\"$fleet\" | feature_type=~\"$functionality_feature\"" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true },
      "fieldConfig": { "defaults": {} }
    }
  ]
}
