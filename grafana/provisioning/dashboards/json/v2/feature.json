{
  "uid": "v2-feature",
  "title": "Feature (v2)",
  "tags": ["feature", "v2"],
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "fleet",
        "type": "query",
        "label": "Fleet",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio, fleet_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "functionality_feature",
        "type": "query",
        "label": "Functionality Feature",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\"}, feature_type)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "component",
        "type": "query",
        "label": "Component",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(component_health_ratio{fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\"}, component_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "title": "\u2b06 Fleet",
      "type": "link",
      "url": "/d/v2-fleet?var-fleet=$fleet",
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Components",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "$component",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (component_name, component_type, fleet_name, feature_type) (component_health_ratio{fleet_name=~\"$fleet\", feature_type=~\"$functionality_feature\", component_name=~\"$component\"})",
          "legendFormat": "{{component_name}}"
        }
      ],
      "repeat": "component",
      "repeatDirection": "h",
      "maxPerRow": 4,
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "range", "options": { "from": 0, "to": 0.49, "result": { "text": "UNHEALTHY", "color": "red", "index": 0 } } },
            { "type": "range", "options": { "from": 0.5, "to": 0.99, "result": { "text": "DEGRADED", "color": "orange", "index": 1 } } },
            { "type": "range", "options": { "from": 1, "to": 1, "result": { "text": "HEALTHY", "color": "green", "index": 2 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" },
          "links": [
            {
              "title": "Drill down to Component Type",
              "url": "/d/v2-ct-${__field.labels.component_type}?var-fleet=$fleet&var-functionality_feature=$functionality_feature&var-component=${__field.labels.component_name}",
              "targetBlank": false
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    }
  ]
}
