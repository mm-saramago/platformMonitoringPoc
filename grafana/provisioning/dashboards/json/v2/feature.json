      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 14,
  "links": [
    {
      "icon": "external link",
      "title": "⬆ Fleet",
      "type": "link",
      "url": "/d/v2-fleet?var-fleet=$fleet"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Components of Functionality : $feature_name",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "targetBlank": false,
              "title": "Drill down to Component Type",
              "url": "/d/v2-ct-${__field.labels.component_type}?var-fleet=$fleet&var-functionality_feature=$functionality_feature&var-component=${__field.labels.component_name}"
            }
          ],
          "mappings": [
            {
              "options": {
                "from": 0,
                "result": {
                  "color": "red",
                  "index": 0,
                  "text": "UNHEALTHY"
                },
                "to": 0.49
              },
              "type": "range"
            },
            {
              "options": {
                "from": 0.5,
                "result": {
                  "color": "orange",
                  "index": 1,
                  "text": "DEGRADED"
                },
                "to": 0.99
              },
              "type": "range"
            },
            {
              "options": {
                "from": 1,
                "result": {
                  "color": "green",
                  "index": 2,
                  "text": "HEALTHY"
                },
                "to": 1
              },
              "type": "range"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "maxPerRow": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "repeat": "component_name",
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg (component_health_ratio{fleet_name=~\"$fleet\", feature_name=~\"$feature_name\", component_name=\"$component_name\"})",
          "legendFormat": "{{component_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "$component_name",
      "type": "stat"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "feature",
    "v2"
  ],
